# Postgres connection string (Neon via the Vercel Marketplace in production).
# Use the POOLED connection string (host contains "-pooler") for Vercel.
# Locally, point to the same Neon database to edit the real content,
# or to a local Postgres / Neon branch to experiment safely.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Schema changes go through migrations (pnpm migrate:create / pnpm migrate).
# Set to "true" ONLY when DATABASE_URL points to a throwaway local database.
# DATABASE_PUSH=true

# Vercel Blob token for media uploads (Storage > Blob in the Vercel dashboard).
# Without it, uploads are saved to public/media (local only, not shared).
BLOB_READ_WRITE_TOKEN=

# Used to encrypt JWT tokens. MUST be the same everywhere that shares the database.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash.
# On Vercel set it to the production domain (e.g. https://your-site.com).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loads only in production builds and only
# after the visitor accepts the cookie notice. Empty: no analytics and no notice.
NEXT_PUBLIC_GA_ID=
